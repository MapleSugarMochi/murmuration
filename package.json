{
  "name": "murmuration",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @murmuration/server --filter @murmuration/web dev",
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sim": "pnpm --filter @murmuration/sim start",
    "loadtest": "pnpm --filter @murmuration/loadtest start",
    "e2e": "pnpm --filter @murmuration/web e2e"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "2.1.9",
    "eslint": "9.15.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "fast-check": "3.23.1",
    "globals": "15.15.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "2.1.9"
  }
}
