{
  "name": "tandem",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @tandem/server --filter @tandem/web dev",
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sim": "pnpm --filter @tandem/sim start",
    "loadtest": "pnpm --filter @tandem/loadtest start",
    "e2e": "pnpm --filter @tandem/web e2e"
  },
  "devDependencies": {
    "@eslint/js": "9.15.0",
    "@types/node": "22.9.0",
    "@vitest/coverage-v8": "2.1.8",
    "eslint": "9.15.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "fast-check": "3.23.1",
    "globals": "15.12.0",
    "prettier": "3.3.3",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "typescript-eslint": "8.15.0",
    "vitest": "2.1.8"
  }
}
