# Copy to .env and adjust. Every variable is optional in development.

# Postgres; when unset, documents live in memory and vanish on restart.
# Use 127.0.0.1, not localhost: with Docker Desktop on Windows, localhost goes
# over IPv6 and adds ~40 ms to every parameterised query (docs/benchmarks.md).
DATABASE_URL=postgres://murmuration:murmuration@127.0.0.1:5432/murmuration

# Signs resume tokens. Required (32+ chars) when NODE_ENV=production.
SESSION_SECRET=

PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info

# Comma-separated WebSocket origins; empty allows any origin.
ALLOWED_ORIGINS=

# Serve the built web app from this directory (production image sets it).
PUBLIC_DIR=

# Tuning
ROOM_IDLE_SECONDS=60
SNAPSHOT_EVERY=1000
COMMIT_DELAY_MS=5

# Abuse limits; raise for load tests from one machine.
MAX_CONNECTIONS_PER_IP=50
JOINS_PER_SECOND_PER_IP=5
DOCS_PER_MINUTE_PER_IP=12
