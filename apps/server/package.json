{
  "name": "@murmuration/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node22 --sourcemap --outfile=dist/main.js --external:fastify --external:@fastify/static --external:ws --external:pg --external:prom-client --external:zod --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\"",
    "start": "node --enable-source-maps dist/main.js",
    "migrate": "tsx src/migrate-cli.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/static": "8.3.0",
    "@murmuration/doc-model": "workspace:*",
    "@murmuration/protocol": "workspace:*",
    "@murmuration/room": "workspace:*",
    "fastify": "5.12.7",
    "pg": "8.23.1",
    "prom-client": "15.1.3",
    "ws": "8.22.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@murmuration/sync-client": "workspace:*",
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.2",
    "esbuild": "0.24.0"
  }
}
